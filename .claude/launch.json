{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viral-city",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "viral-city-localdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "DATABASE_URL": "postgresql://postgres@127.0.0.1:5433/postgres?sslmode=disable",
        "APP_URL": "http://localhost:3001"
      }
    }
  ]
}