# Copie para .env.local e preencha. Sem estas variáveis o painel roda em modo demo.

# Banco (Postgres; em produção, Neon). Use a connection string "pooled" do Neon.
DATABASE_URL=
# Login (Better Auth). Segredo de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Senha do painel enquanto o login não está configurado (modo demo)
APP_PASSWORD=

# Fase 2 — YouTube Data API v3 (grátis, cota diária)
YOUTUBE_API_KEY=

# Fase 3 — endereço público do app (use o HTTPS do túnel para TikTok/Instagram)
APP_URL=http://localhost:3000
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# OAuth do Google (Google Cloud › Credenciais › ID do cliente OAuth, tipo Web).
# Serve para conectar canais do YouTube e para "Continuar com Google" no login.
# URIs de redirecionamento: APP_URL/api/oauth/youtube/callback e APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth do TikTok (developers.tiktok.com › Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth do Instagram (developers.facebook.com › API com login do Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# CityCoins — pagamentos pela Stripe (use as chaves de teste sk_test_ enquanto testa)
STRIPE_SECRET_KEY=
# Segredo do webhook (Stripe › Desenvolvedores › Webhooks, ou `stripe listen` no PC: whsec_...)
STRIPE_WEBHOOK_SECRET=
