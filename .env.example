# Copie para .env.local e preencha. Sem estas variáveis o painel roda em modo demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Senha do painel enquanto o Supabase não está ativo (obrigatória na versão online)
APP_PASSWORD=

# Fase 2 — YouTube Data API v3 (grátis, cota diária)
YOUTUBE_API_KEY=

# Fase 3 — endereço público do app (use o HTTPS do túnel para TikTok/Instagram)
APP_URL=http://localhost:3000
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# OAuth do YouTube (Google Cloud › Credenciais › ID do cliente OAuth, tipo Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth do TikTok (developers.tiktok.com › Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth do Instagram (developers.facebook.com › API com login do Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Fases 4 e 5 — banco da Viral City (tabelas vc_). Chave secreta: só no servidor e no worker!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
